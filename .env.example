# vendor-storefronts — multi-tenant customer storefronts ({slug}.nashemann.store)
#
# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# Never commit .env.local. Vars marked "public" are exposed to the browser.

# --- App URLs (public) ---
# AGENTS.md documents this app on :3003 and vendor-admins on :3002.
NEXT_PUBLIC_APP_URL=http://localhost:3003
NEXT_PUBLIC_SITE_URL=http://localhost:3003
# Base URL of vendor-admins.
NEXT_PUBLIC_ADMIN_URL=http://localhost:3002

# --- Supabase (commerce project: eznxsosvsgkhexbjoolh) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Publishable key used by newer @supabase/ssr clients.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cron / internal ---
# Bearer secret required by the WhatsApp retry worker under /api/cron.
CRON_SECRET=
NASHEMANN_MAILER_URL=

# --- Email ---
RESEND_API_KEY=
# Where operational alerts are sent.
ADMIN_ALERT_EMAIL=
GMAIL_USER=
# Gmail App Password, not the account password.
GMAIL_APP_PASSWORD=

# --- WhatsApp order notifications (Meta Cloud API) ---
WHATSAPP_ACCESS_TOKEN=
# Used to verify X-Hub-Signature-256 on the webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ORDER_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANGUAGE=en
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# --- AI ---
GROQ_API_KEY=
